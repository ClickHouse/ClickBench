#!/bin/bash
# Drop+create the test DB, install pg_deltax, set up the partitioned hits table,
# enable compression, and direct-backfill load the 100 hits_*.parquet files in
# a single COPY ... WITH (FORMAT deltax_compress).
set -eu

PARQUET_DIR=/var/lib/pg_deltax/parquet
PSQL="psql -X -h /var/run/postgresql -U postgres -v ON_ERROR_STOP=1"

# Stage parquet files inside /var/lib/pg_deltax/parquet (kept inside the
# /var/lib/pg_deltax bind mount so both container and host modes see the same
# path without unmounting the parent directory). Dereference symlinks when
# running on read-only playground dataset mounts; otherwise O(1) rename on /.
sudo mkdir -p "$PARQUET_DIR"
sudo rm -f "$PARQUET_DIR"/*.parquet
for f in hits_*.parquet; do
    if [ -L "$f" ]; then
        sudo cp -L "$f" "$PARQUET_DIR/"
        rm -f "$f"
    else
        sudo mv "$f" "$PARQUET_DIR/"
    fi
done
sudo chmod 644 "$PARQUET_DIR"/*.parquet 2>/dev/null || true

# Recreate the DB so this script is idempotent.
$PSQL -d postgres -t -c "DROP DATABASE IF EXISTS test"
$PSQL -d postgres -t -c "CREATE DATABASE test"

# Bump work_mem for the load only. Cap at MemTotal/64 (within [64MB, 1024MB])
# so pg_deltax's decoder pool × work_mem leaves headroom on 16 GiB VMs.
load_wm_mb=$(awk '/MemTotal/{ printf "%d", $2/1024/64 }' /proc/meminfo)
[ "$load_wm_mb" -lt 64 ] && load_wm_mb=64
[ "$load_wm_mb" -gt 1024 ] && load_wm_mb=1024
$PSQL -d postgres -t -c "ALTER DATABASE test SET work_mem TO '${load_wm_mb}MB'"

mem_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
if [ "$mem_kb" -lt $((24 * 1024 * 1024)) ]; then
    $PSQL -d postgres -t -c "ALTER DATABASE test SET pg_deltax.parallel_workers TO 2"
fi

$PSQL -d test -t -c "CREATE EXTENSION pg_deltax"

# Schema + partitioning + compression setup. mock_now pins the partition
# boundary calculation to the dataset's epoch (the hits data is from 2013).
$PSQL -d test -t < create.sql
$PSQL -d test -t -c "SET pg_deltax.mock_now = '2013-07-01 12:00:00'; SELECT deltax.deltax_create_table('hits', 'eventtime', '3 days'::interval, 15)"
$PSQL -d test -t -c "SELECT deltax.deltax_enable_compression('hits', order_by => ARRAY['counterid', 'userid', 'eventtime'])"

# Direct backfill: load and compress in a single pass using FORMAT deltax_compress.
$PSQL -d test -c "COPY hits FROM '$PARQUET_DIR/hits_*.parquet' WITH (FORMAT deltax_compress)"

$PSQL -d test -t -c "VACUUM FREEZE ANALYZE hits"

# Restore default work_mem (64MB) and disable JIT for the query phase.
$PSQL -d postgres -t -c "ALTER DATABASE test RESET work_mem"
$PSQL -d postgres -t -c "ALTER DATABASE test SET jit TO off"

# Free disk: the source parquet files are no longer needed.
sudo rm -f "$PARQUET_DIR"/*.parquet
sync

#!/bin/bash
# Installs the latest OpenSearch of the current major version (3.x) from the
# official APT repository:
# https://docs.opensearch.org/latest/install-and-configure/install-opensearch/debian/
set -e -o pipefail

export DEBIAN_FRONTEND=noninteractive

OPENSEARCH_MAJOR="3"

retry() {
    local i
    for i in $(seq 1 10); do
        "$@" && return 0
        echo "install: '$*' failed (attempt ${i}), retrying" >&2
        sleep 10
    done
    return 1
}

retry sudo apt-get update -y
retry sudo apt-get install -y ca-certificates curl wget gnupg2 jq python3 pigz

if [ ! -x /usr/share/opensearch/bin/opensearch ]; then
    sudo mkdir -p /etc/apt/keyrings
    curl -fsSL --retry 10 --retry-delay 10 --retry-all-errors https://artifacts.opensearch.org/publickeys/opensearch-release.pgp \
        | sudo gpg --dearmor --yes --batch -o /etc/apt/keyrings/opensearch.gpg
    echo "deb [signed-by=/etc/apt/keyrings/opensearch.gpg] https://artifacts.opensearch.org/releases/bundle/opensearch/${OPENSEARCH_MAJOR}.x/apt stable main" \
        | sudo tee "/etc/apt/sources.list.d/opensearch-${OPENSEARCH_MAJOR}.x.list" >/dev/null
    retry sudo apt-get update -y
    # The package requires an initial admin password for its demo security
    # configuration, which is disabled below anyway.
    retry sudo env OPENSEARCH_INITIAL_ADMIN_PASSWORD="ClickBench_Hits-2026!" apt-get install -y opensearch
fi

# A single node without the security plugin (plain HTTP, no users), as the
# Elasticsearch entry runs without X-Pack security. This replaces the demo
# security configuration that the package appends.
sudo tee /etc/opensearch/opensearch.yml >/dev/null <<'CONFIG'
path.data: /var/lib/opensearch
path.logs: /var/log/opensearch

discovery.type: single-node
network.host: 127.0.0.1

plugins.security.disabled: true
CONFIG

# The heap: half of the memory, at most 31 GB (for compressed object
# pointers), which is what Elasticsearch chooses by itself. The default of the
# package is 1 GB. jvm.options.d overrides jvm.options.
heap_gb=$(awk '/^MemTotal:/ { h = int($2 / 1024 / 1024 / 2); if (h > 31) h = 31; if (h < 1) h = 1; print h }' /proc/meminfo)
printf -- '-Xms%sg\n-Xmx%sg\n' "${heap_gb}" "${heap_gb}" | sudo tee /etc/opensearch/jvm.options.d/heap.options >/dev/null
sudo chown root:opensearch /etc/opensearch/opensearch.yml /etc/opensearch/jvm.options.d/heap.options
sudo chmod 640 /etc/opensearch/jvm.options.d/heap.options

# Required by OpenSearch (mmapfs), see
# https://docs.opensearch.org/latest/install-and-configure/install-opensearch/index/#important-settings
sudo sysctl -w vm.max_map_count=262144

sudo mkdir -p /etc/systemd/system/opensearch.service.d
sudo tee /etc/systemd/system/opensearch.service.d/override.conf >/dev/null <<'UNIT'
[Service]
TimeoutStartSec=900
UNIT

sudo systemctl daemon-reload
sudo systemctl enable opensearch.service

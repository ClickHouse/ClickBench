#!/bin/bash
set -e -o pipefail

if [ ! -x ./clickhouse ]; then
    curl -fsSL --retry 10 --retry-delay 60 --retry-all-errors https://clickhouse.com/ | sh
fi

# The binary is self-extracting: it decompresses itself on the first run.
# Do it here, rather than when ./start and ./check run it at the same time.
./clickhouse --version

# Filesystem cache in tmpfs (/dev/shm) for S3 reads, so the hot tries read
# from RAM instead of re-fetching from S3. ./flush-caches removes it before
# each cold try, while the server is stopped.
#
# max_size must not exceed /dev/shm's capacity, or ClickHouse refuses to
# start (Code 36, BAD_ARGUMENTS). /dev/shm defaults to half of RAM, which is
# below the 16G we want on every machine under 32 GiB, so cap the cache at
# half of /dev/shm (a quarter of RAM): it then always fits and never starves
# query execution of memory.
#
# Keep the cache in tmpfs on every size rather than spilling to a disk cache
# on the small ones: their local EBS volume is far slower than same-region
# S3, and routing reads through it roughly tripled the datalake runtime.
cache_max=16000000000
shm_bytes=$(df -B1 -P /dev/shm 2>/dev/null | awk 'NR==2 {print $2}')
: "${shm_bytes:=2000000000}"
half_shm=$(( shm_bytes / 2 ))
[ "$half_shm" -lt "$cache_max" ] && cache_max=$half_shm

# Use plain LRU instead of the default SLRU: SLRU puts new file segments into
# a probationary queue of only 40% of max_size (slru_size_ratio = 0.6), so a
# cold scan that reads more than that evicts its own segments before the hot
# tries can hit them. With the cache at a quarter of RAM, that made Q28, Q32
# and Q33 read everything from S3 on every try on the 32 GiB machines.
#
# The server merges config.d/*.yaml next to config.yaml.
mkdir -p config.d
cat > config.d/filesystem_cache.yaml <<YAML
filesystem_caches:
    cache:
        path: '/dev/shm/clickhouse/'
        max_size: $cache_max
        cache_policy: LRU
YAML

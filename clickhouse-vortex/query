#!/bin/bash
# Reads a SQL query from stdin, runs it via clickhouse-local with the table
# definition from create.sql prepended. Stdout: query result. Stderr: query
# runtime in fractional seconds on the last line. Exit non-zero on error.
# --tmp: since 26.11, clickhouse-local keeps its databases in
# ~/.local/share/clickhouse-local, and `hits` would already exist in the second
# query.
set -e

query=$(cat)
./clickhouse local --tmp --time --format=Pretty --query="$(cat create.sql); ${query}"

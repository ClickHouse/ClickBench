#!/bin/bash
set -e -o pipefail

# The master build rather than the latest release: the Vortex format is not
# in a release yet.
if [ ! -x ./clickhouse ]; then
    curl -fsSL --retry 10 --retry-delay 60 --retry-all-errors https://clickhouse.com/ |
        CLICKHOUSE_BRANCH=master CLICKHOUSE_ONLY=1 sh
fi
# The binary is self-extracting: it decompresses itself on the first run.
./clickhouse --version
# For the run log: a master build may come with another Vortex version.
echo "Vortex version: $(./clickhouse local --query "
    SELECT if(count() = 0, 'unknown', any(value))
    FROM system.build_options WHERE name = 'VORTEX_VERSION'")"

#!/bin/bash
set -e

venv/bin/python - "$(cat)" <<'EOF'
import sys, time, prestodb

cursor = prestodb.dbapi.connect(host="localhost", port=8081, user="clickbench",
                                catalog="hive", schema="clickbench",
                                session_properties={"offset_clause_enabled": "true"}).cursor()
start = time.monotonic()
try:
    cursor.execute(sys.argv[1])
    rows = cursor.fetchall()
except prestodb.exceptions.PrestoUserError as error:
    sys.exit(error.message)
elapsed = time.monotonic() - start

for row in rows:
    print("\t".join("NULL" if value is None else str(value) for value in row))
print(f"{elapsed:.3f}", file=sys.stderr)
EOF

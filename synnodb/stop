#!/bin/bash

cd "$(dirname "$0")"

if [ -f server.pid ]; then
    pid=$(cat server.pid)
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" || true
        # Wait up to 30 s for the server and its engine process to exit.
        for _ in $(seq 1 30); do
            if ! kill -0 "$pid" 2>/dev/null; then
                break
            fi
            sleep 1
        done
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f server.pid
fi

# Release the memory of the Arrow image the engine was loaded from.
rm -rf /dev/shm/synno-ingest-*
rm -f synnodb.sock

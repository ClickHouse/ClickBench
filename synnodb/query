#!/bin/bash
# Reads a SQL query from stdin, sends it to the running SynnoDB server.
# Stdout: server response JSON (the time, who served the query, the number of rows).
# Stderr: query runtime in fractional seconds on the last line.
# Exit non-zero on error.
set -e

cd "$(dirname "$0")"

query=$(cat)

tmp=$(mktemp)
status=$(curl -sS -o "$tmp" -w '%{http_code}' --unix-socket synnodb.sock \
    -X POST --data-binary @- http://localhost/query <<<"$query")

body=$(cat "$tmp")
rm -f "$tmp"

if [ "$status" != "200" ]; then
    echo "query failed: HTTP $status: $body" >&2
    exit 1
fi

echo "$body"
echo "$body" | python3 -c 'import json,sys; print(json.load(sys.stdin)["elapsed"])' >&2

#!/bin/bash
set -eu

# DuckDB engine stores all tables in a single file in the MariaDB data
# directory: __duckdb.db since MariaDB 13 (mariadb-plugin-duckdb), duckdb.db
# in the older builds. information_schema.TABLES does not report DuckDB
# storage size, so we measure the file directly, with its WAL if any.
sudo find /var/lib/mysql -maxdepth 1 -type f \
    \( -name '__duckdb.db' -o -name '__duckdb.db.wal' -o -name 'duckdb.db' -o -name 'duckdb.db.wal' \) \
    -printf '%s\n' | awk '{ s += $1 } END { print s + 0 }'

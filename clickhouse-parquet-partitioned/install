#!/bin/bash
set -e -o pipefail

if [ ! -x ./clickhouse ]; then
    curl -fsSL --retry 10 --retry-delay 60 --retry-all-errors https://clickhouse.com/ | sh
fi
# The binary is self-extracting: it decompresses itself on the first run.
# Do it here, rather than when ./start and ./check run it at the same time.
./clickhouse --version

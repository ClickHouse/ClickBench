#!/bin/bash
# Reads a SQL query from stdin and runs it with the hits-regolith binary
# (DataFusion SQL over parallel regolith range scans).
# Stdout: query result.
# Stderr: query runtime in fractional seconds on the last line (printed by
# the binary itself; it measures SQL execution, not process startup).
# Exit non-zero on error.
set -e

hits-regolith/target/release/hits-regolith query db create.sql

#!/bin/bash
# Reads a SQL query from stdin, runs it with the Trino Python client.
# Stdout: query result, tab-separated.
# Stderr: query runtime in fractional seconds on the last line.
# Exit non-zero on error.
#
# The runtime is measured inside the client process, from sending the query
# to receiving the last row. Starting the Trino CLI (a JVM, through
# `docker exec`) for every query added about a second to each run.
set -e

venv/bin/python - "$(cat)" <<'EOF'
import sys, time, trino

cursor = trino.dbapi.connect(host="localhost", port=8080, user="clickbench",
                             catalog="iceberg", schema="clickbench").cursor()
start = time.monotonic()
try:
    cursor.execute(sys.argv[1])
    rows = cursor.fetchall()
except trino.exceptions.TrinoQueryError as error:
    sys.exit(error.message)
elapsed = time.monotonic() - start

for row in rows:
    print("\t".join("NULL" if value is None else str(value) for value in row))
print(f"{elapsed:.3f}", file=sys.stderr)
EOF

#!/bin/bash
# Reads a SQL query from stdin, runs it via clickhouse-client against the S3
# table created by ./load, reading through the filesystem cache configured by
# ./install. Stdout: query result. Stderr: query runtime in fractional seconds
# on the last line (from --time). Exit non-zero on error.
set -e

./clickhouse client --time --format=Pretty --filesystem_cache_name cache

#!/bin/bash
set -e

query=$(cat)

raw=$(psql -t -c '\timing' -c "$query" 2>&1) && exit_code=0 || exit_code=$?

if [ "$exit_code" -ne 0 ] || printf '%s\n' "$raw" | grep -qE '^ERROR|psql: error'; then
    printf '%s\n' "$raw" >&2
    exit 1
fi

printf '%s\n' "$raw" | grep -v '^Time:' || true

ms=$(printf '%s\n' "$raw" | grep -oP 'Time:\s*\K[0-9.]+' | tail -n1)
if [ -z "$ms" ]; then
    echo "no Time: in psql output" >&2
    exit 1
fi

LC_ALL=C printf '%.3f\n' "$(echo "$ms / 1000" | bc -l)" >&2

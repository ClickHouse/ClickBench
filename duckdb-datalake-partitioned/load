#!/bin/bash
set -e

# create.sql installs httpfs and defines a VIEW directly over S3 partitioned
# parquet — no local data is loaded. Persist the view in hits.db.
. ../lib/dataset-bucket.sh
rm -f hits.db
trap 'rm -f create.rewritten.sql' EXIT
bench_dataset_sql < create.sql > create.rewritten.sql
duckdb hits.db -f create.rewritten.sql
sync

#!/bin/bash
# Usage: download-hits-parquet-partitioned [destination-dir]
# Downloads hits_0.parquet … hits_99.parquet. Files end up in the current
# directory unless a destination directory is given as the first argument.
set -e

dir="${1:-.}"
mkdir -p "$dir"
cd "$dir"

missing=0
for i in $(seq 0 99); do
    [ -f "hits_$i.parquet" ] || { missing=1; break; }
done
if [ "$missing" = 0 ]; then
    echo "All hits_*.parquet files already exist, skipping download"
    exit 0
fi

seq 0 99 | xargs -P100 -I{} bash -c 'wget --continue --quiet https://datasets.clickhouse.com/hits_compatible/athena_partitioned/hits_{}.parquet'

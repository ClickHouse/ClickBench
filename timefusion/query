#!/bin/bash
# Reads a SQL query from stdin, runs it via psql against TimeFusion.
# Stdout: query result.
# Stderr: query runtime in fractional seconds on the last line (parsed from
# psql's `\timing` output).
# Exit non-zero on error.
set -e
source "$(dirname "$0")/env.sh"

query=$(cat)

out=$(printf '\\timing\n%s\n' "$query" | psql -h 127.0.0.1 -p "$TF_PORT" -U postgres -d postgres -t -v ON_ERROR_STOP=1 2>&1) && status=0 || status=$?

if [ "$status" -ne 0 ] || printf '%s\n' "$out" | grep -q '^ERROR\|psql: error'; then
    printf '%s\n' "$out" >&2
    exit 1
fi

printf '%s\n' "$out" | grep -v '^Time:'

time_ms=$(printf '%s\n' "$out" | grep -oP 'Time:\s+\K[0-9]+\.[0-9]+' | tail -n1)
if [ -z "$time_ms" ]; then
    echo "no timing in psql output" >&2
    exit 1
fi
awk -v ms="$time_ms" 'BEGIN { printf "%.3f\n", ms / 1000 }' >&2

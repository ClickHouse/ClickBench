#!/bin/bash
# Called by the driver between ./stop and ./start for cold runs. TimeFusion
# keeps a persistent disk cache (Foyer) of objects read from S3, which would
# otherwise survive the restart and make the cold run warm.
source "$(dirname "$0")/env.sh"

if ! pgrep -x timefusion >/dev/null; then
    rm -rf "$TIMEFUSION_DATA_DIR/cache"
fi

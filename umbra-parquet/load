#!/bin/bash
set -eu

# No ingestion: the view reads the parquet in place, so the file the driver
# downloaded has to stay around for the whole run.
mkdir -p data
mv hits.parquet data/
chmod -R 777 data

PGPASSWORD=postgres psql -p 5432 -h 127.0.0.1 -U postgres \
    -v ON_ERROR_STOP=1 -f create.sql

sync

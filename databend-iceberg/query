#!/bin/bash
# Reads a SQL query from stdin, runs it via bendsql over the Iceberg table.
# Stdout: query result. Stderr: wall-clock runtime in fractional seconds on
# the last line. Exit non-zero on error.
set -e

query=$(cat)

start=$(date +%s.%N)
./bin/bendsql --output=table --query="$query"
end=$(date +%s.%N)

awk -v s="$start" -v e="$end" 'BEGIN { printf "%.3f\n", e - s }' >&2

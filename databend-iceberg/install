#!/bin/bash
# A nightly build: writes into Iceberg tables are recent in Databend.
set -eu

VERSION=v1.2.960-nightly
case "$(uname -m)" in
    x86_64|amd64)  arch=x86_64 ;;
    aarch64|arm64) arch=aarch64 ;;
esac
tarball="databend-${VERSION}-${arch}-unknown-linux-gnu.tar.gz"

if [ ! -x ./bin/databend-query ]; then
    curl -fsSL --retry 10 -o "${tarball}" "https://github.com/databendlabs/databend/releases/download/${VERSION}/${tarball}"
    tar xzf "${tarball}"
    rm -f "${tarball}"
fi

# Databend keeps its own catalog metadata on local storage; the Iceberg
# table itself is in the Iceberg catalog.
# The configuration follows configs/databend-query.toml of the release, with
# local paths.
cat > config.toml <<'CONF'
[query]
flight_api_address = "127.0.0.1:9090"
admin_api_address = "127.0.0.1:8080"
metric_api_address = "127.0.0.1:7070"
mysql_handler_host = "127.0.0.1"
mysql_handler_port = 3307
http_handler_host = "127.0.0.1"
http_handler_port = 8000
flight_sql_handler_host = "127.0.0.1"
flight_sql_handler_port = 8900
tenant_id = "default"
cluster_id = "default"

[[query.users]]
name = "root"
auth_type = "no_password"

[log]
[log.file]
level = "WARN"
format = "text"
dir = "./_logs"

[meta]
endpoints = ["127.0.0.1:9191"]
username = "root"
password = "root"
client_timeout_in_second = 60
auto_sync_interval = 60

[storage]
type = "fs"
# Allows reading the source Parquet files from the local filesystem
# (`fs://`) in the INSERT; it does not affect how the data is written.
allow_insecure = true

[storage.fs]
data_path = "./_data"
CONF

../lib/iceberg/install

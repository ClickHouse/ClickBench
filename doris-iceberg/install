#!/bin/bash
set -e

VERSION=4.1.5
case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
esac
DORIS_HOME="$PWD/apache-doris-$VERSION-bin-$arch"

if [ ! -d "$DORIS_HOME" ]; then
    wget --continue --progress=dot:giga \
        "https://apache-doris-releases.oss-accelerate.aliyuncs.com/apache-doris-$VERSION-bin-$arch.tar.gz"
    tar zxf "apache-doris-$VERSION-bin-$arch.tar.gz"
    rm -f "apache-doris-$VERSION-bin-$arch.tar.gz"
    printf "\npriority_networks = 127.0.0.1/32\n" >> "$DORIS_HOME/fe/conf/fe.conf"
    printf "\npriority_networks = 127.0.0.1/32\n" >> "$DORIS_HOME/be/conf/be.conf"
fi

sudo apt-get update -y
sudo apt-get install -y openjdk-17-jdk-headless mysql-client bc
sudo sysctl -w vm.max_map_count=2000000

# cloud-init adds a 16 GB swapfile to every benchmark instance, and
# start_be.sh refuses to launch while swap is active ("Disable swap memory
# before starting be"), so the backend never started. Turn it off, as
# doris-parquet-single does (persists until reboot; instances never reboot
# mid-run).
sudo swapoff -a

echo "$DORIS_HOME" > .doris_home

../lib/iceberg/install

#!/bin/bash
# Creates the Iceberg table through the REST catalog and writes the dataset
# into it with a single INSERT with the default settings. The source is the
# `local()` table function over the downloaded Parquet files, which reads
# paths relative to the backend directory.
set -e

../lib/iceberg/prepare
source ../lib/iceberg/env.sh
DORIS_HOME=$(cat .doris_home)

mv hits_*.parquet "$DORIS_HOME/be/"

{
    ../lib/iceberg/substitute < catalog.sql
    cat create.sql insert.sql
} | mysql -h127.0.0.1 -P9030 -uroot

rm -f "$DORIS_HOME"/be/hits_*.parquet

# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$SCRIPT_DIR/silicium_server.pid"

if [ -f "$PID_FILE" ]; then
    PID="$(cat "$PID_FILE")"
    if kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
        for i in $(seq 1 50); do
            if ! kill -0 "$PID" 2>/dev/null; then
                break
            fi
            sleep 0.1
        done
        kill -9 "$PID" 2>/dev/null || true
    fi
    rm -f "$PID_FILE" "$SCRIPT_DIR/silicium_server.log"
fi

pkill -f "silicium_runner --server" 2>/dev/null || true
exit 0

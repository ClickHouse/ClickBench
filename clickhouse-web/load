#!/bin/bash
set -e

# create.sql is an ATTACH TABLE that points to a remote web disk; nothing is
# downloaded or written here, the table is materialized on-demand at query
# time, with /dev/shm/clickhouse/ as a local cache. Every read is remote, so
# the endpoint has to be the dataset copy in this machine's part of the world.
. ../lib/dataset-bucket.sh
bench_dataset_sql < create.sql | clickhouse-client
sync

#!/bin/bash
# Reads a SQL query from stdin, runs it via mclient.
# Stdout: query result.
# Stderr: query runtime in fractional seconds on the last line (parsed
# from mclient's `\t clock` output — see the awk below for the shapes).
# Exit non-zero on error.
set -e

query=$(cat)

# Enable clock timing via the -t flag (long: --timer=clock). The
# meta-command form `\t clock` doesn't parse the same way on the
# bundled mclient build: the parser treats the leading `\` as the
# start of an ODBC time literal and aborts with
#   "syntax error, unexpected ODBC_TIME_ESCAPE_PREFIX".
raw=$( (
    printf '%s' "$query"
    printf ';\n'
) | mclient -t clock -h 127.0.0.1 -d test 2>&1 ) && exit_code=0 || exit_code=$?

# mclient may print errors but exit 0; sniff for the canonical markers.
if [ "$exit_code" -ne 0 ] || printf '%s\n' "$raw" | grep -qE '^!|sql:.*error'; then
    printf '%s\n' "$raw" >&2
    exit 1
fi

printf '%s\n' "$raw"

# Parse the LAST `clk:` line into seconds.
timing=$(printf '%s\n' "$raw" | grep -E '^clk:' | tail -n1)
if [ -z "$timing" ]; then
    echo "no clk timing in monetdb output" >&2
    exit 1
fi

# mclient's human-readable clock switches unit as the duration grows
# (clients/mapiclient/mclient.c):
#   clk: 123.456 ms     < 1 s
#   clk: 12.345 sec     < 1 min
#   clk: 2:05 min       < 1 h     -- minutes:seconds, no fraction
#   clk: 1:30 h         >= 1 h    -- hours:minutes
# The colon-separated forms have to be split, not fed to a bare
# numeric conversion: awk reads "2:05" as 2, so a 2m05s query used to
# be recorded as 2.000 seconds — a 60x understatement that silently
# turned the slowest queries into the fastest ones.
awk -v s="$timing" 'BEGIN {
    split(s, a, " ")
    val = a[2]; unit = a[3]
    if (index(val, ":") > 0) {
        split(val, b, ":")
        if (unit == "h") { secs = b[1] * 3600 + b[2] * 60 }
        else             { secs = b[1] * 60 + b[2] }
    } else if (unit == "ms") {
        secs = val / 1000
    } else {
        secs = val
    }
    printf "%.3f\n", secs
}' >&2

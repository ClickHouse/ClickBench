#!/bin/bash
set -eu

# MonetDB 11.55 (Dec2025) refuses to run its servers as root:
#   fatal: running as root is not allowed
# (release notes: "It is no longer allowed to run mserver5 or monetdbd
# as root"). Everything daemon-side therefore runs as the `monetdb`
# system user the package creates, and the dbfarm is the packaged
# default the systemd unit also uses — /var/lib/monetdb is only that
# user's home directory, not a dbfarm.
DBFARM=/var/monetdb5/dbfarm

echo "deb https://dev.monetdb.org/downloads/deb/ $(lsb_release -cs) monetdb" \
    | sudo tee /etc/apt/sources.list.d/monetdb.list

sudo wget --output-document=/etc/apt/trusted.gpg.d/monetdb.gpg \
    https://www.monetdb.org/downloads/MonetDB-GPG-KEY.gpg

sudo apt-get update -y
sudo apt-get install -y monetdb5-sql monetdb-client dos2unix net-tools

# The package ships an initialized dbfarm plus a tmpfiles.d rule for the
# pidfile directory, but neither is guaranteed: /run is a tmpfs, and the
# dbfarm is only pre-created on some builds. Creating them here is
# idempotent — `mkdir -p` leaves an existing directory's mode alone, and
# `monetdbd create` on an initialized dbfarm is a harmless no-op.
sudo mkdir -p /run/monetdb /var/log/monetdb "$DBFARM"
sudo chown monetdb:monetdb /run/monetdb /var/log/monetdb "$DBFARM"

# Own the daemon's lifecycle outright. The package ships (and enables)
# a monetdbd.service with `Restart=on-failure`; if systemd ever brings
# it up, the SIGTERM our ./stop sends looks like a failure and systemd
# restarts the daemon underneath the cold-run cycle — ./check keeps
# succeeding, bench_wait_stopped burns its 60 s timeout, and the "cold"
# query is served from a still-warm process.
sudo systemctl disable --now monetdbd 2>/dev/null || true

sudo -u monetdb monetdbd create "$DBFARM" 2>/dev/null || true
sudo -u monetdb monetdbd start "$DBFARM" || true
sudo usermod -a -G monetdb "$(id -un)"

# `mclient` looks for credentials in ~/.monetdb (user= / password=).
# Without it the default `monetdb` user gets an interactive password
# prompt, which times out the check loop. Stamp the config now so
# every later mclient call (check, load, query) just works.
sudo install -m 0600 /dev/null /root/.monetdb
sudo tee /root/.monetdb >/dev/null <<'EOF'
user=monetdb
password=monetdb
EOF

# monetdbd takes a moment to come up; retry creating the test DB.
# Fail loudly if it never does: swallowing this is what turned a
# daemon that refused to start into a 300 s `./check` timeout with
# nothing in the log but "control socket does not exist".
created=""
for _ in {1..60}; do
    if sudo monetdb create test 2>/dev/null \
        || sudo monetdb status test >/dev/null 2>&1; then
        created=yes
        break
    fi
    sleep 1
done
if [ -z "$created" ]; then
    echo "monetdb install: monetdbd never came up on $DBFARM" >&2
    sudo -u monetdb monetdbd start "$DBFARM" >&2 || true
    sudo tail -20 /var/log/monetdb/merovingian.log >&2 || true
    exit 1
fi
sudo monetdb release test || true

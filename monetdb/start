#!/bin/bash
set -eu

# Must match install/stop/data-size: the packaged dbfarm, served by
# monetdbd running as the `monetdb` user (11.55 refuses to run as root).
DBFARM=/var/monetdb5/dbfarm

# Idempotent: if mserver is already serving the test DB, do nothing.
# Both user and password come from /root/.monetdb (stamped by install).
# Don't pass -u — that disables the file's password and forces an
# interactive prompt — so `mclient` only gets -h / -d here.
if echo 'SELECT 1;' | \
    mclient -h 127.0.0.1 -d test >/dev/null 2>&1; then
    exit 0
fi

# /run is a tmpfs: after a reboot the pidfile directory monetdbd's
# properties point at is gone until systemd-tmpfiles recreates it.
sudo mkdir -p /run/monetdb
sudo chown monetdb:monetdb /run/monetdb

# A hard kill (or a Firecracker snapshot+restore) leaves monetdbd's
# lock files (.merovingian.lock + .gdk_lock) on disk while the
# processes themselves are gone. `monetdbd start` then exits with
# "another monetdbd is already running" and doesn't relaunch, so
# `mclient` never gets a server to talk to and ./check spins for its
# whole timeout. Force a clean slate when nothing is actually alive.
if ! pgrep -x monetdbd >/dev/null; then
    sudo rm -f "$DBFARM/.merovingian.lock" "$DBFARM/.gdk_lock"
    sudo pkill -KILL -x mserver5 2>/dev/null || true
fi

sudo -u monetdb monetdbd start "$DBFARM" || true

# After daemon-side restart the test DB lands "stopped"; release +
# start to bring it back online. (release alone is not enough — it
# only un-marks maintenance; start actually starts mserver5 for it.)
sudo monetdb release test 2>/dev/null || true
sudo monetdb start   test 2>/dev/null || true

# Wait for connections to actually go through. Try a couple of host
# spellings — without -h, mclient hunts for unix sockets that may not
# exist on a fresh restart; with -h 127.0.0.1 it goes straight to TCP.
last_err=""
for _ in $(seq 1 120); do
    for host in 127.0.0.1 localhost; do
        # Feed SQL via stdin — some mclient versions seem to print
        # --help when -s ARG comes after -d. Stdin avoids the
        # argument-parsing ambiguity entirely.
        if echo 'SELECT 1;' | \
            mclient -h "$host" -d test \
            >/dev/null 2>&1; then
            exit 0
        fi
    done
    last_err=$(echo 'SELECT 1;' | \
        mclient -h 127.0.0.1 -d test 2>&1 || true)
    sleep 1
done
echo "monetdb start: mclient still failing after 120 s" >&2
echo "  last mclient error: $last_err" >&2
sudo monetdb status 2>&1 | tail -20 >&2 || true
sudo ss -ltnp | grep -E ':5000[0-9]\b' >&2 || true
exit 1

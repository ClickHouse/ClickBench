#!/bin/bash
set -e

# On stderr, so stdout stays the single number the driver parses.
# lib/benchmark-common.sh only calls ./data-size outside the measured load and
# query windows, so this costs the benchmark nothing.
./statistics-report final >&2 || true

clickhouse-client --query "SELECT total_bytes FROM system.tables WHERE name = 'hits' AND database = 'default'"

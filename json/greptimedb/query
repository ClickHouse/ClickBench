#!/bin/bash
# Reads a SQL query from stdin, runs it with the HTTP SQL API.
# Stdout: the result (JSON). Stderr: the runtime in fractional seconds on the
# last line: the wall-clock time of the HTTP request, as in the original
# JSONBench.
set -e

query=$(cat)

out=$(mktemp /var/tmp/greptimedb-query.XXXXXX)
trap 'rm -f "${out}"' EXIT

time_s=$(curl -sS --fail-with-body -o "${out}" -w '%{time_total}' \
    http://localhost:4000/v1/sql --data-urlencode "sql=${query}") && status=0 || status=$?

if [ "${status}" -ne 0 ] || jq -e 'has("error")' "${out}" >/dev/null 2>&1; then
    cat "${out}" >&2
    echo >&2
    exit 1
fi

cat "${out}"
echo
echo "${time_s}" >&2

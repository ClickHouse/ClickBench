#!/bin/bash
set -e -o pipefail

# Idempotent: recreate the database.
sudo mariadb -e "DROP DATABASE IF EXISTS bluesky"
sudo mariadb -e "CREATE DATABASE bluesky"
sudo mariadb bluesky < ddl.sql

# One LOAD DATA LOCAL INFILE per file, from the decompressed stream, every
# line into the JSON column: the field terminator (0x01) never occurs in the
# data, and there is no escape character, so the lines arrive unchanged.
#
# A few lines of the dataset are not valid JSON: documents of more than
# 64 KiB that were cut into two lines. ../lib/filter-documents.py drops them,
# so that one bad line can't cost the rest of its file, and also the documents
# nested deeper than 32 levels, the limit of MariaDB's JSON functions (error
# 4040, ER_JSON_DEPTH), which the JSON_VALID check of the column would reject,
# failing the load of the file: file 178 has four documents nested 2163
# levels deep (no other document of the files checked is deeper than 9).
#
# Permissive, as in the original JSONBench: a file that fails anyway is skipped (the
# documents that were loaded are reported as the data quality), and the load fails
# only if nothing was loaded.
loaded=0
for file in $(ls "${BENCH_DATA_DIR}"/file_*.json.gz | head -n "${BENCH_FILES}"); do
    echo "load: ${file}"
    if gzip -dc "${file}" \
        | python3 -I ../lib/filter-documents.py --max-depth 32 \
        | sudo mariadb --local-infile=1 bluesky -e "LOAD DATA LOCAL INFILE '/dev/stdin' INTO TABLE bluesky CHARACTER SET utf8mb4 FIELDS TERMINATED BY X'01' ENCLOSED BY '' ESCAPED BY '' LINES TERMINATED BY '\\n' (data); SHOW WARNINGS LIMIT 10;"; then
        loaded=$((loaded + 1))
    else
        echo "load: failed to load ${file}, skipped" >&2
    fi
done
if [ "${loaded}" -eq 0 ]; then
    echo "load: no file was loaded" >&2
    exit 1
fi

sudo mariadb bluesky -e "ANALYZE TABLE bluesky"

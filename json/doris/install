#!/bin/bash
set -e -o pipefail

export DEBIAN_FRONTEND=noninteractive

# The latest Apache Doris release: the release notes of the latest GitHub
# release link the binary tarballs on the official mirror. The tag names are
# irregular (4.1.5-release, 4.1.4.1, 4.0.3-rc03), the links are not.
case "$(uname -m)" in
    x86_64|amd64) ARCH=x64 ;;
    aarch64|arm64) ARCH=arm64 ;;
    *) echo "doris: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

DORIS_HOME="$(pwd)/apache-doris"

sudo apt-get update -y
sudo apt-get install -y openjdk-17-jdk-headless mysql-client jq curl wget

if [ ! -d "$DORIS_HOME" ]; then
    URL=$(curl -fsSL --retry 10 --retry-delay 30 --retry-all-errors \
            https://api.github.com/repos/apache/doris/releases/latest \
        | jq -r '.body' \
        | grep -oE "https://apache-doris-releases\.oss-accelerate\.aliyuncs\.com/apache-doris-[^/()]*-bin-${ARCH}\.tar\.gz" \
        | head -n1)
    if [ -z "$URL" ]; then
        echo "doris: cannot find the ${ARCH} tarball in the latest GitHub release" >&2
        exit 1
    fi
    echo "doris: installing from $URL"

    TARBALL="/var/tmp/$(basename "$URL")"
    wget --continue --tries=10 --waitretry=30 --retry-connrefused --progress=dot:giga -O "$TARBALL" "$URL"
    rm -rf "${DORIS_HOME}.tmp"
    mkdir -p "${DORIS_HOME}.tmp"
    tar -xzf "$TARBALL" --strip-components 1 -C "${DORIS_HOME}.tmp"
    rm -f "$TARBALL"
    mv "${DORIS_HOME}.tmp" "$DORIS_HOME"
fi

# Required by the BE to start at all (the BE refuses to start otherwise).
sudo sysctl -w vm.max_map_count=2000000

#!/bin/bash
# Reads a YQL query from stdin, runs it with `ydb sql`.
# Stdout: the result. Stderr: the runtime in fractional seconds on the last
# line, the server-side duration of the query (total_duration_us of the
# statistics, as in the main ClickBench YDB entry).
set -e

query=$(cat)

cd "$(dirname "$0")"
source ./env.sh

raw=$("${YDB[@]}" sql -s "${query}" --stats basic 2>&1) && status=0 || status=$?

if [ "${status}" -ne 0 ]; then
    printf '%s\n' "${raw}" >&2
    # If the database node has crashed, save its output for the log (see
    # ./data-size): wait for it to exit, it may be writing a core dump.
    if grep -q 'Socket closed' <<< "${raw}"; then
        for _ in $(seq 1 120); do
            pgrep -f "${YDBD} server .*--tenant" >/dev/null || break
            sleep 1
        done
        crash="logs/crash-$(date +%s).out"
        {
            echo "--- database.out"; cat logs/database.out
            echo "--- database.log"; tail -n 20 logs/database.log
        } > "${crash}" 2>&1 || true
    fi
    exit "${status}"
fi

printf '%s\n' "${raw}"

us=$(printf '%s\n' "${raw}" | grep -oP 'total_duration_us:\s*\K[0-9]+' | tail -n1)
if [ -z "${us}" ]; then
    echo "query: no total_duration_us in the output" >&2
    exit 1
fi
awk -v u="${us}" 'BEGIN { printf "%.6f\n", u / 1000000 }' >&2

#!/bin/bash
# Reads a YQL query from stdin, runs it with `ydb sql`.
# Stdout: the result. Stderr: the runtime in fractional seconds on the last
# line, the server-side duration of the query (total_duration_us of the
# statistics, as in the main ClickBench YDB entry).
set -e

query=$(cat)

cd "$(dirname "$0")"
source ./env.sh

raw=$("${YDB[@]}" sql -s "${query}" --stats basic 2>&1) && status=0 || status=$?

if [ "${status}" -ne 0 ]; then
    printf '%s\n' "${raw}" >&2
    # If the database node is gone, show why.
    if ! pgrep -f "${YDBD} server .*--tenant" >/dev/null; then
        # ./data-size prints these files into the log of the driver.
        cp logs/database.out "logs/crash-$(date +%s).out" || true
        dmesg 2>/dev/null | tail -n 20 >> "logs/crash-$(date +%s).out" || true
        echo "query: the database node is not running; its output is saved in logs/crash-*.out" >&2
    fi
    exit "${status}"
fi

printf '%s\n' "${raw}"

us=$(printf '%s\n' "${raw}" | grep -oP 'total_duration_us:\s*\K[0-9]+' | tail -n1)
if [ -z "${us}" ]; then
    echo "query: no total_duration_us in the output" >&2
    exit 1
fi
awk -v u="${us}" 'BEGIN { printf "%.6f\n", u / 1000000 }' >&2

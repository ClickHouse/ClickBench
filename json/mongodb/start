#!/bin/bash
set -e

sudo systemctl start mongod

# mongod can take a while to accept connections after a restart.
for _ in $(seq 1 300); do
    if mongosh --quiet --eval "db.runCommand({ping: 1}).ok" >/dev/null 2>&1; then
        exit 0
    fi
    sleep 1
done

echo "mongod did not become reachable within 300s" >&2
sudo systemctl status mongod --no-pager -l 2>&1 | tail -n 30 >&2 || true
sudo tail -n 60 /var/log/mongodb/mongod.log >&2 || true
exit 1

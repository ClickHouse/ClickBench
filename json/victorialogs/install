#!/bin/bash
set -e -o pipefail

# The latest release from GitHub. VictoriaLogs has its own repository since
# 2025 (it was released from VictoriaMetrics/VictoriaMetrics before).
if [ ! -x ./victoria-logs-prod ]; then
    VERSION=$(curl -fsSL --retry 10 --retry-delay 10 --retry-all-errors \
        https://api.github.com/repos/VictoriaMetrics/VictoriaLogs/releases/latest | jq -r .tag_name)
    if [ -z "${VERSION}" ] || [ "${VERSION}" = "null" ]; then
        echo "install: cannot resolve the latest VictoriaLogs release" >&2
        exit 1
    fi
    ARCH=$(dpkg --print-architecture)
    NAME="victoria-logs-linux-${ARCH}-${VERSION}"
    TMP=$(mktemp -d /var/tmp/victorialogs.XXXXXX)
    wget --quiet --tries=10 --waitretry=10 --retry-connrefused --retry-on-http-error=429,500,502,503,504 \
        -O "${TMP}/${NAME}.tar.gz" \
        "https://github.com/VictoriaMetrics/VictoriaLogs/releases/download/${VERSION}/${NAME}.tar.gz"
    tar xzf "${TMP}/${NAME}.tar.gz" -C "${TMP}"
    mv "${TMP}/victoria-logs-prod" ./victoria-logs-prod
    rm -rf "${TMP}"
    echo "${VERSION}" > victorialogs.version
fi

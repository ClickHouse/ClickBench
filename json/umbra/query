#!/bin/bash
# Reads a query from stdin, runs it with psql. Stderr: the runtime in fractional
# seconds on the last line, from psql's `\timing`.
set -e
source ./env.sh

query=$(cat)

out=$(printf '\\timing on\n%s\n' "${query}" | ${PSQL} -t 2>&1) && status=0 || status=$?
if [ "${status}" -ne 0 ] || printf '%s\n' "${out}" | grep -qE '^(ERROR|FATAL|PANIC):|psql: error'; then
    printf '%s\n' "${out}" >&2
    exit 1
fi

time_ms=$(printf '%s\n' "${out}" | grep -oP '^Time: \K[0-9]+(\.[0-9]+)?' | tail -n1)
if [ -z "${time_ms}" ]; then
    printf '%s\n' "${out}" >&2
    echo "query: no timing in the psql output" >&2
    exit 1
fi

printf '%s\n' "${out}" | grep -v '^Time: \|^Timing is on\.'
awk -v ms="${time_ms}" 'BEGIN { printf "%.3f\n", ms / 1000 }' >&2

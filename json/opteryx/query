#!/bin/bash
# Reads a query from stdin and runs it on the query server.
# Stdout: the result as TSV. Stderr: the runtime in fractional seconds on the
# last line, measured by the server (the drain of execute_to_morsels).
set -e

body=$(mktemp)
trap 'rm -f "$body"' EXIT

meta=$(curl -sS -o "$body" -w '%{http_code} %header{x-elapsed}' \
    -X POST --data-binary @- http://127.0.0.1:8421/query) || {
    echo "query failed: no response from server (see server.log)" >&2
    exit 1
}

code=${meta%% *}
elapsed=${meta#* }

if [ "$code" != "200" ] || [ -z "$elapsed" ]; then
    echo "query failed: HTTP $code" >&2
    cat "$body" >&2
    exit 1
fi

cat "$body"
echo "$elapsed" >&2

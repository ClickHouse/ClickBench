#!/bin/bash
# The same as ../mongodb/load: the collection and the index from ../mongodb/ddl.js
# (FerretDB ignores the WiredTiger compression option there), then one
# mongoimport per file with the invalid lines of the dataset dropped.
set -e -o pipefail

mongosh --quiet bluesky --eval 'db.dropDatabase()' >/dev/null
mongosh --quiet bluesky --file ddl.js

for file in $(ls "${BENCH_DATA_DIR}"/file_*.json.gz | head -n "${BENCH_FILES}"); do
    echo "load: ${file}" >&2
    gzip -dc "${file}" \
        | python3 -I -c '
import json
import sys

out = sys.stdout.buffer
skipped = 0
for line in sys.stdin.buffer:
    try:
        valid = isinstance(json.loads(line), dict)
    except ValueError:
        valid = False
    if valid:
        out.write(line)
    else:
        skipped += 1
if skipped:
    print(f"load: skipped {skipped} invalid lines", file=sys.stderr)
' \
        | mongoimport --db bluesky --collection bluesky
done

#!/bin/bash
# The client only needs the AWS CLI v2 and credentials. The cluster (or
# serverless workgroup) is created by ./provision, outside the benchmark.
set -e
cd "$(dirname "$0")"

if ! command -v aws >/dev/null; then
    sudo apt-get update -y
    sudo apt-get install -y unzip curl
    tmp=$(mktemp -d)
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o "$tmp/awscli.zip"
    unzip -q "$tmp/awscli.zip" -d "$tmp"
    sudo "$tmp/aws/install" --update
    rm -rf "$tmp"
fi

# The native client for ./query, ./check and concurrent-worker.
if ! python3 -m venv --help >/dev/null 2>&1 || ! python3 -c 'import ensurepip' 2>/dev/null; then
    sudo apt-get update -y
    sudo apt-get install -y python3-venv
fi
[ -x .venv/bin/python3 ] || python3 -m venv .venv
.venv/bin/pip install --quiet redshift_connector==2.2.0

source ./env.sh
aws sts get-caller-identity >/dev/null

#!/usr/bin/env bash
# ==============================================================================
# STANDARD COMPLIANT RUNNER LIFECYCLE - UNTUNED BASELINE
# ==============================================================================
set -e

# Securely terminate any lingering execution process contexts safely
if [ -f server.pid ]; then 
    kill "$(cat server.pid)" 2>/dev/null || true
fi

# Activate the production execution environment boundaries cleanly
source myenv/bin/activate

# Launch the server application frame transparently under standard OS schedules
nohup python3 server.py > server.log 2>&1 &
echo $! > server.pid

echo "==> [SUCCESS] Standard polars-dataframe runner lifecycle initiated."

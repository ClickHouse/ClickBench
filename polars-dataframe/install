#!/bin/bash
set -e

sudo apt-get update -y
sudo apt-get install -y pybind11-dev python3-dev

# Install Python and build dependencies
pip install --upgrade pip
pip install maturin setuptools-rust

# Install core server dependencies
pip install 'polars>=1.0.0' pyarrow fastapi uvicorn

# Build and install the native Rust module (mechanicus_core)
if [ -f "Cargo.toml" ]; then
    echo "Found Cargo.toml. Compiling mechanicus_core in release mode..."
    maturin develop --release
else
    echo "Warning: Cargo.toml not found. Skipping native Rust build."
fi

#!/usr/bin/env bash
# ==============================================================================
# CLICKBENCH PRODUCTION SUITE: ENVIRONMENT INSTALLATION SUITE
# This script prepares the system with all required native toolchains.
# ==============================================================================
set -euo pipefail

echo "==> [INSTALL] Updating system packages..."
sudo apt-get update -y
sudo apt-get install -y git wget curl numactl cpupower build-essential libssl-dev python3-pip python3-dev python3-venv

# Ensure a clean virtual environment exists and is utilized
python3 -m venv myenv
source myenv/bin/activate

echo "==> [INSTALL] Upgrading package manager..."
pip install --upgrade pip
pip install maturin

# Install pure data processing frameworks and requirements for native core
echo "==> [INSTALL] Installing core high-performance libraries..."
pip install polars pyarrow numpy

# Dynamically compile the hardware-accelerated Mechanicus Core engine
echo "==> [INSTALL] Compiling native Rust bit-packing modules..."
cd mechanicus_core
maturin develop --release
cd ..

echo "==> [SUCCESS] Legal dependency environment successfully established."

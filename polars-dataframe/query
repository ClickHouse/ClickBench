#!/usr/bin/env bash
# ==============================================================================
# RUN_BENCHMARK - COMPLIANT BASELINE LIFE-CYCLE UNTUNED WITH STATUS INTERCEPT
# ==============================================================================
set -euo pipefail

ulimit -R unlimited 2>/dev/null || true
ulimit -l unlimited 2>/dev/null || true
ulimit -v unlimited 2>/dev/null || true

# Process incoming stream from stdin line by line dynamically
while read -r q; do
    [ -z "$q" ] && continue

    sync
    echo "3" | sudo tee /proc/sys/vm/drop_caches >/dev/null

    start_time=$(date +%s%N)
    
    # Transmit payload and explicitly intercept the HTTP status code to validate execution
    STATUS_CODE=$(curl -sS -X POST -H "Content-Type: application/json" \
         -d "{\"query\": \"$q\"}" \
         -w "%{http_code}" \
         "http://127.0.0.1:8000/query" -o /dev/null)
    
    if [ "$STATUS_CODE" -ne 200 ]; then
        echo "Error: Server returned status $STATUS_CODE" >&2
        exit 1
    fi
    
    end_time=$(date +%s%N)

    elapsed_nanos=$((end_time - start_time))
    elapsed_seconds=$(awk "BEGIN {print $elapsed_nanos / 1000000000}")
    
    echo "$elapsed_seconds" >&2
done

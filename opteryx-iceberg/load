#!/bin/bash
# Creates the Iceberg table through the REST catalog and writes the dataset
# into it with a single INSERT ... SELECT with the default settings (load.py).
# opteryx reads `FROM hits` as ./hits/*.parquet, so the downloaded files are
# moved there first.
set -e

../lib/iceberg/prepare
source ./env

mkdir -p hits
mv hits_*.parquet hits/
"$HOME/opteryx_iceberg_venv/bin/python" load.py
rm -rf hits
sync

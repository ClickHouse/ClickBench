#!/bin/bash
set -eu

FB_TAG=${FB_TAG:-v5.0.4}
FB_BUILD=${FB_BUILD:-5.0.4.1812-0}

case "$(uname -m)" in
    x86_64) FB_ARCH=x64 ;;
    aarch64) FB_ARCH=arm64 ;;
    *) echo "Unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

sudo apt-get update -y
sudo apt-get install -y libtommath1 libicu-dev libncurses6 g++ wget

# Ubuntu packages only Firebird 3.0, so install the official release tarball.
FB_DIR="Firebird-${FB_BUILD}-linux-${FB_ARCH}"
wget --continue --progress=dot:giga "https://github.com/FirebirdSQL/firebird/releases/download/${FB_TAG}/${FB_DIR}.tar.gz"
tar xzf "${FB_DIR}.tar.gz"
(cd "${FB_DIR}" && sudo ./install.sh -silent)
rm -rf "${FB_DIR}" "${FB_DIR}.tar.gz"

# Replace the random SYSDBA password generated by the installer with a known one.
OLD_PASSWORD=$(sudo grep -oP '^ISC_PASSWORD=\K.*' /opt/firebird/SYSDBA.password)
echo "ALTER USER SYSDBA PASSWORD 'clickbench'; COMMIT;" \
    | sudo /opt/firebird/bin/isql -q -b -user SYSDBA -password "$OLD_PASSWORD" localhost:employee

sudo mkdir -p /var/lib/firebird/data /var/lib/firebird/tmp
sudo chown -R firebird:firebird /var/lib/firebird

echo 'hits = /var/lib/firebird/data/hits.fdb' | sudo tee -a /opt/firebird/databases.conf >/dev/null

# The loader uses the batch API of the client library in embedded mode.
sudo g++ -O2 -std=c++17 -I/opt/firebird/include -o /usr/local/bin/firebird-hits-loader loader.cpp \
    -L/opt/firebird/lib -Wl,-rpath,/opt/firebird/lib -lfbclient -pthread

# Memory settings in the spirit of the postgresql entry: a quarter of RAM for
# the page cache and another quarter for in-memory sorts. Firebird 5 executes
# every query in one thread; parallel workers are used for index creation.
memory=$(awk '/MemTotal/ {print $2 * 1024}' /proc/meminfo)
page_size=32768
cache_pages=$((memory / 4 / page_size))
temp_cache=$((memory / 4))
threads=$(nproc)

sudo tee -a /opt/firebird/firebird.conf >/dev/null <<EOF

# ClickBench
DefaultDbCachePages = ${cache_pages}
# A page cache larger than FileSystemCacheThreshold would switch the database
# files to O_DIRECT and lose the kernel's read-ahead for table scans.
UseFileSystemCache = true
TempCacheLimit = ${temp_cache}
TempDirectories = /var/lib/firebird/tmp
MaxParallelWorkers = ${threads}
ParallelWorkers = ${threads}
EOF

sudo systemctl restart firebird

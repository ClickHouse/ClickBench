#!/bin/bash
# Reads a SQL query from stdin, runs it via a fresh duckdb process that
# attaches the Iceberg catalog. Stdout: query result. Stderr: runtime in
# fractional seconds on the last line. Exit non-zero on error.
set -e
source ../lib/iceberg/env.sh

query=$(cat)
attach=$(../lib/iceberg/substitute < attach.sql)
err=$(mktemp)
trap 'rm -f "$err"' EXIT

out=$(duckdb -init /dev/null \
    -c "$attach" \
    -c "USE lake.clickbench" \
    -c ".timer on" \
    -c "$query" 2>"$err") && status=0 || status=$?

if [ "$status" -ne 0 ]; then
    cat "$err" >&2
    exit "$status"
fi

printf '%s\n' "$out" | grep -v '^Run Time '
printf '%s\n' "$out" | awk '/^Run Time/ { print $5 }' | tail -n1 >&2

#!/bin/bash
# tritium's binary, here as ./tritium: the release below (github.com/xmaton/tritium-release) for this machine's
# architecture, checked against its checksum here, so a rerun measures the same binary; or a local linux-release build
# from TRITIUM instead.
set -e
release=https://github.com/xmaton/tritium-release/releases/download/v0.2.0
# The release's SHA256SUMS (release/make-release.sh prints it).
sha256_x86_64=71638369c112bc7ba2b678c3070ffd320e4c99e06cac6581e7d5d5bdc9e5f5c2
sha256_aarch64=3f02e629c63c4e19ebf870eda775c865782a919b71db4935257fbcb6efc4c674

sudo apt-get update -y
sudo apt-get install -y curl

if [ -n "$TRITIUM" ]; then
    cp "$TRITIUM" ./tritium
    exit 0
fi
arch=$(uname -m)
sha256_var=sha256_$arch
curl -fsSL -o tritium "$release/tritium-linux-$arch"
echo "${!sha256_var}  tritium" | sha256sum -c
chmod +x tritium

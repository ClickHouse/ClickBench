#!/bin/bash
# Reads a SQL query from stdin, runs it via roastedDuck against hits.db (which
# contains a VIEW over hits.parquet).
# Stdout: query result. Stderr: query runtime in fractional seconds on the
# last line. Exit non-zero on error.
set -e

query=$(cat)

out=$(roastedDuck hits.db -c "SET parquet_metadata_cache=true" -c ".timer on" -c "$query" 2>/tmp/roastedduck.err.$$) && status=0 || status=$?

if [ "$status" -ne 0 ]; then
    cat /tmp/roastedduck.err.$$ >&2
    rm -f /tmp/roastedduck.err.$$
    exit "$status"
fi
rm -f /tmp/roastedduck.err.$$

printf '%s\n' "$out" | grep -v '^Run Time '
printf '%s\n' "$out" | awk '/^Run Time/ { print $5 }' | tail -n1 >&2

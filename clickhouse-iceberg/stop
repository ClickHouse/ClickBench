#!/bin/bash
# Stops ClickHouse only. The storage keeps running: it plays the role of the
# remote object storage, which survives restarts of the database.

[ -f server-data/clickhouse.pid ] || exit 0
pid=$(cat server-data/clickhouse.pid)
kill "$pid" 2>/dev/null || exit 0
for _ in $(seq 1 60); do
    kill -0 "$pid" 2>/dev/null || exit 0
    sleep 1
done
kill -9 "$pid" 2>/dev/null || true

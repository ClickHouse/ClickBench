#!/bin/bash

if [ -f server.pid ]; then
    pid=$(cat server.pid)
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" || true
        # Wait for the process to be gone: the common runner drops the page
        # cache right after, and the cold run is cold only if nothing holds
        # the array any more.
        for _ in $(seq 1 60); do
            if ! kill -0 "$pid" 2>/dev/null; then
                break
            fi
            sleep 1
        done
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f server.pid
fi

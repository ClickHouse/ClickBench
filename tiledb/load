#!/bin/bash
set -e

# Idempotent: blow away any prior partial array.
rm -rf hits_array

# The ingest is a separate process, not a request to the wrapper server:
# a TileDB array is a directory of immutable fragments, so a writer needs
# nothing from the readers. The server opens the array on the first query
# after its next start.
# shellcheck disable=SC1091
source myenv/bin/activate
python3 load.py

rm -f hits.parquet
sync

#!/usr/bin/env bash
# ==============================================================================
# ENVIRONMENT INSTALLATION SUITE - NATIVE PRODUCTION LAYER
# ==============================================================================
set -euo pipefail

echo "==> [INSTALL] Updating system packages..."
sudo apt-get update -y
sudo apt-get install -y git wget curl numactl cpupower build-essential libssl-dev python3-pip python3-dev python3-venv

# Install Rust toolchain natively since maturin requires cargo
echo "==> [INSTALL] Deploying native compiler toolchain..."
if ! command -v cargo &> /dev/null; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    source "$HOME/.cargo/env"
else
    source "$HOME/.cargo/env" || true
fi

# Establish clean virtual environment
python3 -m venv myenv
source myenv/bin/activate

echo "==> [INSTALL] Upgrading package manager..."
pip install --upgrade pip
pip install maturin

# Install target processing frameworks
echo "==> [INSTALL] Deploying core high-performance frameworks..."
pip install polars pyarrow numpy fastapi uvicorn


echo "==> [SUCCESS] Native dependency environment successfully established."

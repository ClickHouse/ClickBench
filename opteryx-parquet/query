#!/bin/bash
# Reads a SQL query from stdin and runs it on the long-lived server.
# Stdout: query result as TSV (header + rows).
# Stderr: query runtime in fractional seconds on the last line (server-measured
#         drain of execute_to_morsels; see server.py).
# Exit non-zero on error; the traceback is in server.log.
set -e

body=$(mktemp)
trap 'rm -f "$body"' EXIT

meta=$(curl -sS -o "$body" -w '%{http_code} %header{x-elapsed}' \
    -X POST --data-binary @- http://127.0.0.1:8421/query) || {
    echo "query failed: no response from server (see server.log)" >&2
    exit 1
}

code=${meta%% *}
elapsed=${meta#* }

if [ "$code" != "200" ] || [ -z "$elapsed" ]; then
    echo "query failed: HTTP $code" >&2
    cat "$body" >&2
    exit 1
fi

cat "$body"
echo "$elapsed" >&2

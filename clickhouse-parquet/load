#!/bin/bash
set -e

# The File(Parquet) table reads the parquet files in place, so there is no
# ingest step. The server resolves the path of the table relative to its
# user_files directory: symlink the files there and keep them for the queries.
mkdir -p server-data/user_files
for f in hits.parquet; do
    ln -sf "$PWD/$f" "server-data/user_files/$f"
done

./clickhouse client < create.sql
sync

#!/bin/bash
# Set the MotherDuck read_write Duckling (compute) size for this account, then
# wait until the new size is actually serving queries.
#
#   ./set-instance-size <pulse|standard|jumbo|mega|giga>
#
# Duckling size cannot be set via SQL or the md: connection string; it is an
# account / service-account setting changed through the MotherDuck REST API
# (PUT /v1/users/{username}/instances). The flow is:
#   1. SHUTDOWN NORMAL — ask the current duckling to shut down cleanly, so the
#      resize starts from a quiesced instance rather than a forced recycle.
#   2. PUT the new read_write size.
#   3. Wait SETTLE_SECONDS (>=120). This fixed wait is required: it lets the
#      duckling finish shutting down cleanly on its own. Nothing queries
#      MotherDuck during it (a query would keep the old duckling alive).
#   4. Double-check md_live_duckling_size() reports the new size.
#
# Env:
#   motherduck_token / MOTHERDUCK_TOKEN   required (same PAT used for md:)
#   motherduck_username                   optional; auto-discovered via SQL
#   SETTLE_SECONDS                        clean-shutdown + provisioning wait
#                                         after the resize (default 120, min 120)
#   SET_SIZE_TIMEOUT                      extra time to keep polling the live
#                                         size after the settle wait, in seconds
#                                         (default 1800; giga can take ~10 min)
set -eu

size="${1:-}"
case "$size" in
    pulse|standard|jumbo|mega|giga) ;;
    *) echo "usage: $0 <pulse|standard|jumbo|mega|giga>" >&2; exit 2 ;;
esac

export motherduck_token="${motherduck_token:-${MOTHERDUCK_TOKEN:-}}"
: "${motherduck_token:?motherduck_token is required}"

PY=.venv/bin/python3; [ -x "$PY" ] || PY=python3

exec "$PY" - "$size" <<'PY'
import json, os, sys, time, urllib.request

size = sys.argv[1]
token = os.environ["motherduck_token"]
# The clean-shutdown wait is required; never let it drop below 2 minutes.
settle = max(120, int(os.environ.get("SETTLE_SECONDS", "120")))
timeout = int(os.environ.get("SET_SIZE_TIMEOUT", "1800"))
base_api = "https://api.motherduck.com/v1"

try:
    import duckdb
except ImportError:
    sys.exit("set-instance-size: the duckdb Python package is required "
             "(run ./install first, or pip install duckdb)")

def md_one(query):
    return duckdb.connect("md:").execute(query).fetchone()

def discover_username():
    u = os.environ.get("motherduck_username")
    if u:
        return u
    return md_one("SELECT username FROM MD_USER_INFO()")[0]

def req(method, url, body=None):
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(
        url, data=data, method=method,
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/json"})
    with urllib.request.urlopen(r, timeout=60) as resp:
        raw = resp.read().decode()
    return json.loads(raw) if raw else {}

username = discover_username()
base = f"{base_api}/users/{username}/instances"

cur = req("GET", base)
print(f"current read_write size: "
      f"{cur.get('read_write', {}).get('instance_size')}", file=sys.stderr)

# 1. Ask the current duckling to shut down cleanly before resizing. SHUTDOWN
#    NORMAL returns immediately; the actual shutdown then completes on its own
#    over the next couple of minutes (the settle wait below). We drop the
#    connection right after and issue no further queries until the wait is over.
duckdb.connect("md:").execute("SHUTDOWN NORMAL")
print("sent SHUTDOWN NORMAL", file=sys.stderr)

# 2. Resize. The PUT requires both blocks, so preserve read_scaling and change
#    only read_write (the instance the benchmark loads and queries on).
rs = cur.get("read_scaling", {})
body = {"config": {
    "read_write": {"instance_size": size},
    "read_scaling": {k: rs[k] for k in ("instance_size", "flock_size") if k in rs},
}}
req("PUT", base, body)
print(f"requested read_write size -> {size}", file=sys.stderr)

# 3. Wait for the duckling to finish shutting down cleanly on its own. This
#    fixed wait is required; do NOT query MotherDuck during it, or the old
#    duckling would be kept alive and never recycle to the new size.
print(f"waiting {settle}s for clean shutdown + provisioning", file=sys.stderr)
time.sleep(settle)

# 4. Double-check the new size is live. The query here provisions a fresh
#    duckling at the resized config; poll a little longer if propagation lags.
deadline = time.time() + timeout
while True:
    live = md_one("SELECT type FROM md_live_duckling_size()")[0]
    if live.lower() == size.lower():
        print(f"live duckling size is now {live}")
        sys.exit(0)
    if time.time() >= deadline:
        print(f"timed out: live size is {live}, expected {size}", file=sys.stderr)
        sys.exit(1)
    print(f"waiting for {size}; live={live}", file=sys.stderr)
    time.sleep(30)
PY

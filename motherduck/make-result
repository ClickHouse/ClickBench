#!/bin/bash
# Convert a per-size benchmark log (as produced by run-all-sizes.sh) into a
# ClickBench results JSON matching the committed format, e.g.
# results/20261016/jumbo.json.
#
#   ./make-result <size> [logfile] [date]
#
# size     Duckling size; also the result filename and the machine suffix.
# logfile  per-size log to parse (default: motherduck-<size>.log).
# date     run date YYYY-MM-DD (default: today). The results subdirectory drops
#          the dashes (results/YYYYMMDD/<size>.json) to match the repo layout.
#
# Why this exists: the shared cloud-init derives a result's "machine" from the
# client EC2 instance type, which is meaningless for MotherDuck (the compute is
# the remote Duckling). ClickBench supports PR-committed result files, so we
# generate them ourselves with the Duckling size as the machine label — the same
# shape the previous MotherDuck driver committed.
set -eu
size="${1:?usage: ./make-result <size> [logfile] [date]}"
logfile="${2:-motherduck-${size}.log}"
date="${3:-$(date +%F)}"

PY=.venv/bin/python3; [ -x "$PY" ] || PY=python3
exec "$PY" - "$size" "$logfile" "$date" <<'PY'
import json, os, re, sys

size, logfile, date = sys.argv[1], sys.argv[2], sys.argv[3]
log = open(logfile).read()

def find(pattern, label):
    m = re.search(pattern, log, re.M)
    if not m:
        sys.exit(f"make-result: no '{label}' in {logfile}")
    return m.group(1)

load_time = float(find(r'^Load time: ([\d.]+)', 'Load time:'))
data_size = int(find(r'^Data size: (\d+)', 'Data size:'))

rows = []
for line in re.findall(r'^\[([^\]]*)\],?$', log, re.M):
    rows.append([None if x.strip() == 'null' else float(x) for x in line.split(',')])
if not rows:
    sys.exit(f"make-result: no result rows in {logfile}")

tmpl = json.load(open("template.json"))
out = {
    "system": tmpl["system"],
    "date": date,
    # "Motherduck: <size>" matches the machine label of the already-published
    # MotherDuck results (note the lowercase 'd' in the existing data).
    "machine": f"Motherduck: {size}",
    "cluster_size": 1,
    "proprietary": tmpl["proprietary"],
    "hardware": tmpl["hardware"],
    "tuned": tmpl["tuned"],
    "tags": tmpl["tags"],
    "load_time": load_time,
    "data_size": data_size,
    "result": rows,
}

outdir = os.path.join("results", date.replace("-", ""))
os.makedirs(outdir, exist_ok=True)
path = os.path.join(outdir, f"{size}.json")
with open(path, "w") as f:
    json.dump(out, f, indent=4)
    f.write("\n")

print(path)
print(f"  {len(rows)} queries, load_time={load_time}, data_size={data_size}",
      file=sys.stderr)
PY

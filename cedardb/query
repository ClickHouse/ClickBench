#!/bin/bash
# Reads a SQL query from stdin, runs it via psql against CedarDB.
# Stdout: query result.
# Stderr: query runtime in fractional seconds on the last line (parsed from
# psql's `\timing` "Time: <ms> ms" output).
# Exit non-zero on error.
set -e

# CedarDB listens on /tmp/.s.PGSQL.5432; see ./check for context.
export PGHOST=${PGHOST:-/tmp}
export PGUSER=${PGUSER:-postgres}

# ON_ERROR_STOP makes psql exit non-zero on a failed query; its error message
# already goes to stderr.
raw=$(psql -v ON_ERROR_STOP=1 -t -c '\timing' -c "$(cat)")

printf '%s\n' "$raw" | grep -v '^Time:'
printf '%s\n' "$raw" | grep -oP 'Time: \K[0-9.]+' | awk '{ printf "%.3f\n", $1 / 1000 }' >&2

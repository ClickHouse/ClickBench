#!/bin/bash
# Loads through the running server (./start): the server holds the
# .clickbench directory, so no other process can open it.
set -e

# Idempotent: drop any prior table.
echo "DROP TABLE IF EXISTS clickbench.hits SYNC" | ./query >/dev/null
./query < create.sql >/dev/null
./query < insert.sql >/dev/null

rm -f hits.csv
sync

#!/bin/bash
set -eu

sudo apt-get update -y
sudo apt-get install -y postgresql-client docker.io bc

./stop || true
sudo docker rm -f scramdb 2>/dev/null || true
sudo rm -rf ./db
mkdir -p ./db
chmod 777 ./db

ram_kb=$(grep MemTotal /proc/meminfo | tr -dc 0-9)
ram_gb=$(( ram_kb / 1024 / 1024 ))

if [ "$ram_gb" -lt 16 ]; then
    echo "WARNING: ScramDB targets machines with at least 16 GB of RAM; this one has ${ram_gb} GB." >&2
    echo "WARNING: proceeding anyway, but this result is not representative of the product." >&2
fi

# The tuned configuration. The README lists every deviation from the product
# default and its reason.
cat > scramdb-config.toml <<EOF
[general]
jit_enabled = true
metrics_port = 9090
pg_address = "0.0.0.0:5432"
shutdown_jit_quiesce_timeout_secs = 10
shutdown_drain_timeout_secs = 5

[jit]
compiled_cache_memory = "256MB"
compiled_cache_disk = "1024MB"

[storage]
prod_name = "tundra"
shard_id = 0
basedir = "/var/lib/scramdb"
# 0 = auto: the share is derived from the io backend.
buffer_pool_percent = 0
buffer_pool_cap = "192GB"
execution_memory_percent = 25
execution_memory_cap = "64GB"

flush_threshold_rows = 65536
prefetch_depth = 32
prefetch_queue_depth = 256
bloom_max_bytes = "16KB"

[storage.memory]
working_set_percent = 85

[storage.io]
backend = "buffered"

[storage.wal.archive]
enabled = false

[storage.cold_config]
cold_enable = false
writeback_frequency_secs = 0
concurrent_requests = 0
bucket_name = ""
cloud_api = "GCP"
base_path = ""

[execution]
workers = "auto"
morsel_size = "8MB"
copy_batch_rows = 131072
copy_pipeline_depth = 8
spill_agg_partitions = 128
arena_chunk_size = "8MB"

[storage.compaction]
check_interval = "24h"

[storage.gc]
cycle_interval = "24h"

[statistics]
analyze_on_load = false
auto_analyze_check_interval = "24h"

[udf]
enabled = false

[gpu]
enabled = false
EOF

sudo docker pull "${SCRAMDB_IMAGE:-scramdb/scramdb:cb}"

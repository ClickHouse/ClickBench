#!/bin/bash
set -eu

sudo apt-get update -y
sudo apt-get install -y postgresql-client docker.io bc

./stop || true
sudo docker rm -f scramdb 2>/dev/null || true
sudo rm -rf ./db
mkdir -p ./db
chmod 777 ./db

ram_kb=$(grep MemTotal /proc/meminfo | tr -dc 0-9)
ram_mb=$(( ram_kb / 1024 ))
ram_gb=$(( ram_mb / 1024 ))

if [ "$ram_gb" -lt 16 ]; then
    echo "WARNING: ScramDB targets machines with at least 16 GB of RAM; this one has ${ram_gb} GB." >&2
    echo "WARNING: proceeding anyway, but this result is not representative of the product." >&2
fi

jit_mb=$(( ram_mb * 10 / 100 ))
floor_mb=2048
if [ "$floor_mb" -gt $(( ram_mb / 4 )) ]; then floor_mb=$(( ram_mb / 4 )); fi
if [ "$jit_mb" -lt "$floor_mb" ]; then jit_mb=$floor_mb; fi
if [ "$jit_mb" -gt 32768 ]; then jit_mb=32768; fi
jit_disk_mb=$(( jit_mb * 4 ))
if [ "$jit_disk_mb" -lt 4096 ]; then jit_disk_mb=4096; fi
if [ "$jit_disk_mb" -gt 65536 ]; then jit_disk_mb=65536; fi
echo "scramdb-tuned: ${ram_gb} GB RAM detected -> compiled-query cache ${jit_mb}MB memory / ${jit_disk_mb}MB disk"

cat > scramdb-config.toml <<EOF
[general]
jit_enabled = true
metrics_port = 9090
pg_address = "0.0.0.0:5432"
shutdown_jit_quiesce_timeout_secs = 10
shutdown_drain_timeout_secs = 5

[jit]
compiled_cache_memory = "${jit_mb}MB"
compiled_cache_disk = "${jit_disk_mb}MB"

[storage]
prod_name = "tundra"
shard_id = 0
basedir = "/var/lib/scramdb"
buffer_pool_percent = 60
buffer_pool_cap = "192GB"
execution_memory_percent = 15
execution_memory_cap = "64GB"

flush_threshold_rows = 65536
prefetch_depth = 32
prefetch_queue_depth = 256
bloom_max_bytes = "16KB"

[storage.memory]
working_set_percent = 85

[storage.io]
backend = "io_uring"

[storage.wal.archive]
enabled = false

[storage.cold_config]
cold_enable = false
writeback_frequency_secs = 0
concurrent_requests = 0
bucket_name = ""
cloud_api = "GCP"
base_path = ""

[execution]
workers = "auto"
morsel_size = "8MB"
copy_batch_rows = 131072
copy_pipeline_depth = 8
spill_agg_partitions = 128
arena_chunk_size = "8MB"

[storage.compaction]
check_interval = "24h"

[storage.gc]
cycle_interval = "24h"

[statistics]
analyze_on_load = false
auto_analyze_check_interval = "24h"

[udf]
enabled = false

[gpu]
enabled = false
EOF

sudo docker pull "${SCRAMDB_IMAGE:-scramdb/scramdb:latest}"

#!/bin/bash
set -e

# ArcticDB ships manylinux wheels for x86_64 only — there is no Linux
# aarch64 build on PyPI (macOS arm64 and Windows amd64 are the other two
# platforms), and building it from source means a full vcpkg C++ build.
# Fail with that stated rather than letting pip try a source build and
# die a few thousand lines later.
arch=$(uname -m)
if [ "$arch" != "x86_64" ]; then
    echo "install: arcticdb has no Linux ${arch} wheel on PyPI; x86_64 only." >&2
    exit 1
fi

sudo apt-get update -y
sudo apt-get install -y python3-pip python3-venv

if [ ! -d myenv ]; then
    python3 -m venv myenv
fi
# shellcheck disable=SC1091
source myenv/bin/activate
pip install --quiet arcticdb pyarrow fastapi uvicorn

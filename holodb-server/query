#!/bin/bash
# Reads one SQL statement on stdin and sends it to the server. Stdout: the rows. Stderr: the client-timed round trip in
# seconds, as the last line. Exit non-zero on error. The connection and TLS handshake are not timed.
set -e
cd "$(dirname "$0")"
. ./bench.env
exec dotnet bin/HoloDbServerBench.dll query --port "$HOLODB_PORT" --pin-file run/thumbprint --token-file run/token

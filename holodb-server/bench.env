# Shared settings for every script in this system. Sourced by each script; a value set in the environment wins.
# HOLODB_VERSION pins the image tag and the HoloDb NuGet package the loader uses: the store format must match the server.
# To test an image built from the working tree before it is published, build it from the repo root and override:
#   docker build -f HoloDb.Server/Dockerfile -t holodb:local .
#   HOLODB_IMAGE=holodb:local ./benchmark.sh      (the loader still uses the HOLODB_VERSION package)
HOLODB_VERSION="${HOLODB_VERSION:-23.0.2}"
HOLODB_IMAGE="${HOLODB_IMAGE:-ghcr.io/evaluatedapplications/holodb:${HOLODB_VERSION}}"
HOLODB_CONTAINER="${HOLODB_CONTAINER:-holodb-bench}"
HOLODB_PORT="${HOLODB_PORT:-5432}"
# Time limit of one statement. The framework's cold cycle includes a restart, and a cold scan at 100M rows runs for tens of seconds.
HOLODB_STATEMENT_SECONDS="${HOLODB_STATEMENT_SECONDS:-600}"

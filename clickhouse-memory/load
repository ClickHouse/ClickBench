#!/bin/bash
set -e

clickhouse-client < create.sql

# Symlink the parquet files into ClickHouse's user_files dir rather than
# moving them. mv on a 14 GB partitioned dataset wastes minutes copying
# bytes the daemon will only read once; ln -s is instant. chown -h sets the
# symlink's owner (does not follow into the target), which is enough — the
# underlying parquets are mode 644, so the clickhouse user can read them
# through the symlinks regardless.
#
# Unlike the MergeTree entry, the symlinks stay in place after the load: this
# system is not durable, so the driver calls ./load again before every cold
# query and the files are needed 43 more times.
if [ ! -e /var/lib/clickhouse/user_files/hits_0.parquet ]; then
    sudo ln -sf "$PWD"/hits_*.parquet /var/lib/clickhouse/user_files/
    sudo chown -h clickhouse:clickhouse /var/lib/clickhouse/user_files/hits_*.parquet
fi

clickhouse-client --query "INSERT INTO hits SELECT * FROM file('hits_*.parquet')" --max-insert-threads "$(( $(nproc) / 4 ))"

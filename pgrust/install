#!/bin/bash
# install: PostgreSQL 18 client tools (initdb/psql), the pgrust release, initdb, configuration, dataset.
set -eu
. "$(dirname "$0")/env.sh"
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -y -qq
sudo apt-get install -y -qq --no-install-recommends curl ca-certificates gnupg python3 wget
if [ ! -x "$PG18BIN/initdb" ]; then
    sudo install -d /usr/share/postgresql-common/pgdg
    sudo curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt $(. /etc/os-release; echo $VERSION_CODENAME)-pgdg main" | sudo tee /etc/apt/sources.list.d/pgdg.list >/dev/null
    sudo apt-get update -y -qq
    sudo apt-get install -y -qq --no-install-recommends postgresql-client-18 postgresql-18
    sudo systemctl disable --now postgresql >/dev/null 2>&1 || true   # only initdb/psql are used
fi
sudo install -d -o "$PGRUST_USER" -g "$PGRUST_USER" "$PGRUST_HOME" "$PGSOCKDIR"
sudo rm -rf "$PGRUST_PREFIX"; sudo install -d -o "$PGRUST_USER" -g "$PGRUST_USER" "$PGRUST_PREFIX"
if [ -n "$PGRUST_TARBALL" ]; then
    $AS_PG tar -xzf "$PGRUST_TARBALL" --strip-components=1 -C "$PGRUST_PREFIX"
else
    $AS_PG curl -fsSL --retry 5 --retry-delay 5 -o "$PGRUST_HOME/release.tar.gz" "$PGRUST_BIN_URL"
    $AS_PG curl -fsSL --retry 5 --retry-delay 5 -o "$PGRUST_HOME/release.tar.gz.sha256" "$PGRUST_BIN_URL.sha256"
    (cd "$PGRUST_HOME" && echo "$(cut -c1-64 release.tar.gz.sha256)  release.tar.gz" | sha256sum -c -) >/dev/null
    $AS_PG tar -xzf "$PGRUST_HOME/release.tar.gz" --strip-components=1 -C "$PGRUST_PREFIX"
fi
"$PGRUST_PREFIX/bin/postgres" --version
sudo rm -rf "$PGDATA"
$AS_PG "$PG18BIN/initdb" -D "$PGDATA" --no-locale --encoding=UTF8 -U postgres -A trust >/dev/null
# Configuration (README.md)
memory=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
threads=$(nproc)
$AS_PG tee -a "$PGDATA/postgresql.conf" >/dev/null <<CONF
shared_buffers=$((memory / 4))kB
effective_cache_size=$((memory - memory / 4))kB
work_mem=$((memory / (2 * threads)))kB
max_wal_size=32GB
max_worker_processes=$((threads + 15))
max_parallel_workers=${threads}
max_parallel_workers_per_gather=${threads}
max_parallel_maintenance_workers=$((threads / 2))
listen_addresses=''
unix_socket_directories='$PGSOCKDIR'
jit=off
io_method=sync
max_stack_depth=60000
autovacuum=off
pgrust.gravity_grant_mb=$((memory / 4 / 1024))
CONF
# Dataset (untimed)
if [ ! -s "$HITS_PARQUET" ]; then
    $AS_PG wget -q --continue -O "$HITS_PARQUET" https://datasets.clickhouse.com/hits_compatible/hits.parquet   # the server reads it (COPY FROM file)
fi

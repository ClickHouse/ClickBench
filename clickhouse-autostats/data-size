#!/bin/bash
set -e

# Diagnostics for the point of this directory: how much statistics data the
# default auto_statistics_types actually materializes, and whether the server
# spends time on it. On stderr, so stdout stays the single number the driver
# parses — and lib/benchmark-common.sh only calls ./data-size outside the
# measured load and query windows, so this costs the benchmark nothing.
# Never let a diagnostic failure abort the run: the driver treats an empty
# ./data-size as a partial load and gives up on the whole benchmark.
diagnostics() {
    echo -n 'Statistics setting: '
    clickhouse-client --query "SELECT value FROM system.merge_tree_settings WHERE name = 'auto_statistics_types'"
    echo -n 'Statistics files: '
    sudo find /var/lib/clickhouse -name 'statistics.packed' -printf '%s\n' 2>/dev/null \
        | awk '{ n++; s += $1 } END { printf "%d files, %d bytes total\n", n+0, s+0 }'
    echo -n 'Active parts: '
    clickhouse-client --query "SELECT count() FROM system.parts WHERE table = 'hits' AND database = 'default' AND active"
    echo -n 'Server log lines mentioning statistics: '
    sudo grep -ci 'statistic' /var/log/clickhouse-server/clickhouse-server.log || true
    echo 'Last such lines:'
    sudo grep -i 'statistic' /var/log/clickhouse-server/clickhouse-server.log 2>/dev/null \
        | tail -n 5 | cut -c1-200 | sed 's/^/  /' || true
}
diagnostics >&2 || true

clickhouse-client --query "SELECT total_bytes FROM system.tables WHERE name = 'hits' AND database = 'default'"

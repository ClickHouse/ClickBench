#!/bin/bash
set -e

if ! command -v docker >/dev/null 2>&1; then
    sudo apt-get update -y
    sudo apt-get install -y docker.io
fi
sudo apt-get install -y bc

sudo docker pull trinodb/trino:latest

mkdir -p data/meta etc/catalog
sudo chown -R 1000:1000 data

cat > etc/catalog/hive.properties <<'EOF'
connector.name=hive
# trino:455 still ships the legacy hadoop-based file systems. Newer
# trino releases (461+) dropped fs.hadoop.* in favour of native FS
# providers; the native S3 replacement (fs.native-s3.enabled=true)
# has no anonymous-credentials mode, so we'd lose access to the
# public clickhouse-public-datasets bucket. Pin trino:455 and stay
# on the Hadoop FS for both local + S3.
#
# 455 does NOT recognise fs.native-local.enabled / local.location
# (those landed in a later release); leaving them in fails
# Bootstrap with `Configuration property '...' was not used` and
# the JVM exits 100 before /v1/info ever comes up. Use file:///
# (Hadoop RawLocalFileSystem) for the file-metastore path.
hive.metastore=file
hive.metastore.catalog.dir=local:///meta
local.location=/data
fs.native-local.enabled=true
fs.s3.enabled=true
s3.auth-type=ANONYMOUS
s3.region=eu-central-1
s3.endpoint=https://s3.eu-central-1.amazonaws.com
hive.non-managed-table-writes-enabled=true
EOF

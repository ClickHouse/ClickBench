#!/bin/bash
# Runs a Rayfall query from stdin on the server. Stdout: the result; stderr:
# the runtime in seconds on the last line. Non-zero exit on error.
set -e

export RAYFORCE_PORT="${RAYFORCE_PORT:-5000}"
export RAYFORCE_QUERY RAYFORCE_MS
RAYFORCE_QUERY=$(mktemp)
RAYFORCE_MS=$(mktemp)
trap 'rm -f "$RAYFORCE_QUERY" "$RAYFORCE_MS"' EXIT

cat > "$RAYFORCE_QUERY"

rayforce query.rfl

ms=$(cat "$RAYFORCE_MS")
if [ -z "$ms" ]; then
    echo "rayforce: query returned no timing" >&2
    exit 1
fi

# Milliseconds, possibly in exponent form, to plain fractional seconds.
awk -v ms="$ms" 'BEGIN { printf "%.6f\n", ms / 1000 }' >&2

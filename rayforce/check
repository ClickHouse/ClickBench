#!/bin/bash
# Ready = server.rfl has opened the table (server.ready) and the server is alive.
#
# No IPC probe: the server takes new connections only between queries, so in
# the concurrent test a probe waited behind the workers and the watchdog
# restarted a server that was busy, not dead.
set -e

[ -f server.ready ] && [ -f server.pid ] && kill -0 "$(cat server.pid)" 2>/dev/null

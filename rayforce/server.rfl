; Server init script (see ./start): opens the table once per start, so the
; open stays out of the query timings. Before ./load there is no table yet and
; the server stays up without it.

(set hits (try (.db.splayed.get "hits") (fn [e] (println "hits not loaded yet") 0)))
(set hits-ready (== (type hits) 'TABLE))
(if hits-ready (println (format "loaded % rows" (count hits))) 0)

; Once ./hits exists, a failed open is fatal: serving with `hits` bound to 0
; would record query 1 as a valid timing.
(set fatal (and (not hits-ready) (== (.os.getenv "RAYFORCE_REQUIRE_TABLE") "1")))
(if fatal (do (println "./hits exists but could not be opened; refusing to serve") (exit 1)) 0)

; Read by ./check.
(write "server.ready" "ready")

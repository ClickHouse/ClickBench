#!/bin/bash
# Creates the Iceberg table through the REST catalog and writes the dataset
# into it with a single INSERT with the default settings. The source is a
# Hive table over the downloaded Parquet files.
set -e

../lib/iceberg/prepare

for f in hits_*.parquet; do
    ln -f "$f" "data/hits/$f" 2>/dev/null || cp -f "$f" "data/hits/$f"
done

cat source.sql create.sql insert.sql > load.sql
venv/bin/python - load.sql <<'EOF'
import sys, prestodb

cursor = prestodb.dbapi.connect(host="localhost", port=8080, user="clickbench").cursor()
for statement in open(sys.argv[1]).read().split(";"):
    if statement.strip():
        cursor.execute(statement)
        cursor.fetchall()
EOF

rm -f hits_*.parquet data/hits/hits_*.parquet load.sql

#!/bin/bash
set -e

PRESTO_VERSION=0.300

../lib/iceberg/start

if sudo docker ps --format '{{.Names}}' | grep -qx presto; then
    exit 0
fi
if sudo docker ps -a --format '{{.Names}}' | grep -qx presto; then
    sudo docker start presto
    exit 0
fi

# The host network, to reach the storage and the catalog on localhost.
sudo docker run -d --name presto --network host \
    -v "$PWD/etc/catalog/hive.properties:/opt/presto-server/etc/catalog/hive.properties:ro" \
    -v "$PWD/etc/catalog/iceberg.properties:/opt/presto-server/etc/catalog/iceberg.properties:ro" \
    -v "$PWD/etc/jvm.config:/opt/presto-server/etc/jvm.config:ro" \
    -v "$PWD/etc/config.properties:/opt/presto-server/etc/config.properties:ro" \
    -v "$PWD/data:/clickbench" \
    prestodb/presto:${PRESTO_VERSION}

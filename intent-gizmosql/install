#!/bin/bash
set -eu

# cloud-init runs scripts as root with no HOME exported; the per-system
# scripts expect one, so pin a default (same guard as the upstream entry).
HOME="${HOME:-/root}"
export HOME

sudo apt-get update -y
sudo apt-get install -y curl unzip netcat-openbsd

# Install the released gizmosql_server + gizmosql_client of this entry from
# https://github.com/bddppqs/intent-gizmosql (tag v1.38.0-intent.2): portable Linux builds
# (amd64 and arm64) with a glibc 2.28 baseline, so no loader shim is needed
# on Ubuntu 24.04. Each zip is pinned by URL and SHA-256, and the two
# binaries by their own SHA-256; a different file fails the install.
case "$(uname -m)" in
    x86_64)
        ZIP_URL="https://github.com/bddppqs/intent-gizmosql/releases/download/v1.38.0-intent.2/gizmosql_cli_linux_amd64.zip"
        ZIP_SHA256="c6f7a49eecae73acd7ed66b781c5ed0be04f05c7c396fbb21a44f54663ac9cb3"
        SERVER_SHA256="711d9f18e4e6f1c5a9632a21d4be22e594308cfa5e7d6551390332d393c62dff"
        CLIENT_SHA256="ef95e0e264cb8f6f8642409ff6699fb60e2b621ecc11cdcc27da5c1ce4211482"
        ;;
    aarch64)
        ZIP_URL="https://github.com/bddppqs/intent-gizmosql/releases/download/v1.38.0-intent.2/gizmosql_cli_linux_arm64.zip"
        ZIP_SHA256="1218392a736ba204a4cfad8de4847fbddf2a662920dbc822ee1007fa75a7007b"
        SERVER_SHA256="4ef3cef54e6c3dbd84803320f9c45889a3e6c02470563451dc6ea7e76e1b02c8"
        CLIENT_SHA256="d9e596549f3b71e0573e22b8a2dd480db7aacbdd83ad69919a100be8502c6553"
        ;;
    *)
        echo "unsupported architecture: $(uname -m) (this entry ships amd64 and arm64 builds)" >&2
        exit 1
        ;;
esac
if ! command -v gizmosql_server >/dev/null 2>&1; then
    tmp=$(mktemp -d)
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 5 "$ZIP_URL" -o "$tmp/gizmosql.zip"
    echo "$ZIP_SHA256  $tmp/gizmosql.zip" | sha256sum -c -
    unzip -q "$tmp/gizmosql.zip" -d "$tmp"
    sudo install -m 0755 "$tmp/gizmosql_server" "$tmp/gizmosql_client" /usr/local/bin/
    rm -rf "$tmp"
fi
# The installed binaries must be the release's, including ones already
# installed before this script ran.
printf '%s  %s\n%s  %s\n' "$SERVER_SHA256" /usr/local/bin/gizmosql_server \
    "$CLIENT_SHA256" /usr/local/bin/gizmosql_client | sha256sum -c -
gizmosql_server --version

#!/bin/bash
set -e

. ./util.sh

# Ready means the server answers a statement, not only that its port is
# open: SELECT 1 through the query client, with the login util.sh gives
# the query script. It reads no table. The client exits non-zero when it
# cannot connect or log in, or when the statement fails.
exec gizmosql_client -c 'SELECT 1' > /dev/null

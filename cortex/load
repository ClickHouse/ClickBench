#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIR="$SCRIPT_DIR/../data"

mkdir -p "$DATA_DIR"
if [ ! -f "$DATA_DIR/hits.parquet" ] && [ ! -f "$DATA_DIR/hits_sample.parquet" ]; then
    echo "📥 Downloading hits.parquet dataset..."
    curl -sSL "https://datasets.clickhouse.com/hits_compatible/athena_partitioned/hits_0.parquet" -o "$DATA_DIR/hits.parquet" || true
fi
echo "✅ Data ready for CORTEX Analytics Engine."
